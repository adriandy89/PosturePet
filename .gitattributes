# Normaliza los finales de linea: LF en el repositorio siempre.
# Sin esto, cada clon en Windows reescribe archivos enteros y los diffs
# entre plataformas salen llenos de ruido.
* text=auto eol=lf

# Binarios: que git no intente convertirlos ni hacerles diff.
*.png binary
*.ico binary
*.wasm binary
*.task binary
*.exe binary
*.7z binary

# Excluir del paquete npm y de los archivos de release en GitHub.
.github/       export-ignore
test/          export-ignore
.editorconfig  export-ignore
.gitattributes export-ignore
.gitignore     export-ignore
CONTRIBUTING.md export-ignore
